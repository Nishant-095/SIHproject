APP_NAME="Airfare APIx"
APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO

POSTGRES_DB=airfare_apix
POSTGRES_USER=airfare_app
POSTGRES_PASSWORD=replace-with-a-url-safe-local-password
POSTGRES_HOST_PORT=5432
DATABASE_URL=postgresql+psycopg://airfare_app:replace-with-a-url-safe-local-password@localhost:5432/airfare_apix
TEST_DATABASE_URL=postgresql+psycopg://airfare_app:replace-with-a-url-safe-local-password@localhost:5432/airfare_apix_test

COLLECTION_TIMEZONE=Asia/Kolkata
COLLECTION_HOUR=10
COLLECTION_MINUTE=0
SCHEDULER_ENABLED=false
SCHEDULED_SOURCE=fixture

ADAPTER_TIMEOUT_SECONDS=30
ADAPTER_MAX_RETRIES=2
RETRY_BACKOFF_SECONDS=0.5
RETRY_BACKOFF_MAX_SECONDS=4
ENFORCE_SOURCE_RATE_LIMITS=true
CANONICAL_FARE_POLICY=direct-then-median-v1

# Duffel is disabled by default. Never commit a real token.
# Test tokens must keep DUFFEL_LIVE_MODE=false and are stored as RECORDED_DEMO.
# Set SOURCE_APPROVED only after accepting/rechecking the provider agreement.
DUFFEL_API_BASE_URL=https://api.duffel.com
DUFFEL_ACCESS_TOKEN=
DUFFEL_LIVE_MODE=false
DUFFEL_SOURCE_ENABLED=false
DUFFEL_SOURCE_APPROVED=false
DUFFEL_RATE_LIMIT_PER_MINUTE=5
DUFFEL_SUPPLIER_TIMEOUT_MS=20000

# Permissioned web extraction stays disabled until written authorization or an
# expressly licensed source is documented. The profile contains selectors only.
WEB_SOURCE_PROFILE_PATH=
WEB_SOURCE_ENABLED=false
WEB_SOURCE_APPROVED=false
WEB_SOURCE_PERMISSION_REFERENCE=
WEB_SOURCE_USER_AGENT="AirfareAPIxResearchBot/0.1 (permissioned academic fare collection)"
WEB_SOURCE_RATE_LIMIT_PER_MINUTE=2
WEB_SOURCE_BROWSER_TIMEOUT_MS=25000

# Replace this local-only value. Never commit a real token.
ADMIN_TOKEN=change-me-before-use
CORS_ORIGINS='["http://localhost:5173"]'

VITE_API_BASE_URL=http://localhost:8000
